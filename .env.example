# Copy this file to ".env" and set the real domain once it is known.
# It is used for canonical URLs, Open Graph tags, the JSON-LD schema,
# sitemap.xml and robots.txt. No trailing slash.
#
# If it is left unset, the build uses the Netlify / Vercel deploy URL when
# available, and otherwise the placeholder https://www.example.com.
VITE_SITE_URL=https://www.example.com
